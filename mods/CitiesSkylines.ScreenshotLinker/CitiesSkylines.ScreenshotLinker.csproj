<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>CitiesSkylines.ScreenshotLinker</AssemblyName>
    <RootNamespace>CitiesSkylines.ScreenshotLinker</RootNamespace>
    <Deterministic>false</Deterministic>
    <!-- 编译产物直接输出到游戏本地模组文件夹（dotnet build 即发布，无需复制）
         ICities.dll 由游戏环境提供（Private=false 不复制）；0Harmony.dll 随包复制到此处 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(LOCALAPPDATA)\Colossal Order\Cities_Skylines\Addons\Mods\CitiesSkylines.ScreenshotLinker\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- 无 .NET Framework 本机 SDK 也能 dotnet build（NuGet 还原引用程序集） -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- 游戏模组接口（ICities.dll 由游戏环境提供，不随模组复制） -->
    <Reference Include="ICities">
      <HintPath>D:\SteamLibrary\steamapps\common\Cities_Skylines\Cities_Data\Managed\ICities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Harmony 2.x 框架（工坊 2040656402 同款：CitiesHarmony.Harmony.dll 2.0.4.0，含 HarmonyLib 命名空间；
         随模组包携带，与工坊 Harmony 2 模组同结构；游戏已加载同名程序集时自动复用） -->
    <Reference Include="CitiesHarmony.Harmony">
      <HintPath>lib\CitiesHarmony.Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
